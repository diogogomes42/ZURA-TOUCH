{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/o-jogo/:path*", "destination": "/marcas/", "permanent": true },
    { "source": "/espacos/:path*", "destination": "/marcas/", "permanent": true }
  ]
}
